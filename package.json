{
  "name": "nexora-ai-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.js *.json",
    "format:check": "prettier --check src tests scripts vite.config.ts eslint.config.js *.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "audit:publication": "node --experimental-strip-types scripts/audit-publication.mjs",
    "verify:deployment": "node --test tests/deployment.test.mjs",
    "build:github": "node scripts/build-target.mjs github",
    "build:cloudflare": "node scripts/build-target.mjs cloudflare"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
