# Copy to .env.local for local build options. Restart Vite after changing these.
VITE_SITE_PRESET=nexora
VITE_DEMO_MODE=true
VITE_DISABLED_SECTIONS=
# Leave empty for portable ./ locally and root / on Cloudflare Pages.
# Set / for Cloudflare explicitly, or /REPOSITORY/ for a GitHub Pages project.
VITE_BASE_PATH=
# Optional stable public HTTPS homepage URL; no credentials, query or fragment.
# Cloudflare needs the root URL; GitHub Pages includes its repository subpath.
# Leave blank until the real production address exists. All VITE_* values are public.
VITE_SITE_URL=
